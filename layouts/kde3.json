{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    -200,
    -200
  ],
  "preview": "layouts/kde3.svg",
  "theme": "kde3-linux",
  "font": "Menlo",
  "font_size": 13,
  "ui_font": "Tahoma",
  "terminal_padding": [
    3,
