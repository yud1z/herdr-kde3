        {
          "id": "desk-bottom",
          "type": "block",
          "size": {
            "weight": 1
          },
          "content": {
            "mod": "kde3",
            "props": {
              "role": "spacer"
            }
          }
        }
      ]
    },
    {
      "id": "kicker",
      "type": "block",
      "content": {
        "mod": "kde3",
        "props": {
          "role": "panel"
        }
      },
      "size": {
        "px": 36
